PORT=5000
# Set NODE_ENV=production when deploying.
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/smartStudentPortal
# Set this to the frontend origin when it is hosted separately; unset uses same-origin requests.
# CORS_ORIGIN=https://your-frontend.example.com
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
DEMO_MODE=true
DEMO_STUDENT_PASSWORD=replace_with_a_demo_student_password
DEMO_ADMIN_PASSWORD=replace_with_a_demo_admin_password
SUPER_ADMIN_NAME=Portal Owner
SUPER_ADMIN_REGISTER_NUMBER=SUPER-ADMIN-01
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
SUPER_ADMIN_PHONE=0000000000
