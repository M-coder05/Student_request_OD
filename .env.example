# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=re_replace_with_your_resend_api_key
MAIL_FROM=Smart Student Service Portal <notifications@example.com>
COLLEGE_NAME=Your College Name
SIGNATORY_NAME=College Principal
SIGNATORY_TITLE=Principal

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_EXPIRES_IN=7d

# Demo Mode Settings
DEMO_MODE=true
DEMO_STUDENT_PASSWORD=replace_with_a_demo_student_password
DEMO_ADMIN_PASSWORD=replace_with_a_demo_admin_password

# Permanent Super Admin Setup
SUPER_ADMIN_NAME=Portal Owner
SUPER_ADMIN_REGISTER_NUMBER=SUPER-ADMIN-01
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_a_strong_password_min_12_chars
SUPER_ADMIN_PHONE=0000000000
