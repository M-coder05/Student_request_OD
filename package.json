{
  "name": "smart-student-service-portal",
  "version": "1.0.0",
  "description": "Full-stack Smart Student Service Portal with MongoDB, Express, JWT, and React frontend.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test:email": "node test-email.js",
    "test:email-validation": "node backend/scripts/testEmailValidation.js",
    "test:staff-details": "node backend/scripts/testStaffDetails.js",
    "test:password-reset": "node backend/scripts/testPasswordResetMongo.js",
    "test:request-attachments": "node backend/scripts/testRequestAttachmentsMongo.js",
    "test:e2e": "playwright test",
    "seed:admin": "node backend/seedAdmin.js",
    "seed:demo": "node backend/seedDemo.js",
    "client:install": "npm --prefix client install",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client install && npm --prefix client run build"
  },
  "keywords": [
    "student",
    "portal",
    "mongodb",
    "express",
    "jwt",
    "react"
  ],
  "author": "Mohammed Musharaff S",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "nodemon": "3.1.10"
  }
}
